---
// Коло та його елементи для 7 класу: хорди, діаметри, радіуси, трикутник AOB, діаметр ⊥ хорді, дотичні,
// описане й вписане коло трикутника, серединний перпендикуляр і бісектриса кута (bezKola), два кола.
// Точки на колі задаємо кутом (0° — праворуч, 90° — угору), відрізки — парами букв. Малюнок той самий, що в
// тренажерах (src/trenazhery/kolo.ts).
//   <KoloElementy naKoli={{ A: 200, B: 340 }} vidrizky={[{ a: 'O', b: 'A', rysky: 1 }, { a: 'O', b: 'B', rysky: 1 }, { a: 'A', b: 'B' }]} kuty={[{ v: 'A', a: 'O', b: 'B', pidpys: '35°' }]} />
//   <KoloElementy naKoli={{ A: 270 }} dotychni={['A']} vidrizky={[{ a: 'O', b: 'A' }]} priamiKuty={[['A', 'O', 'дотA']]} />
//   <KoloElementy zovnishnia={{ l: 'P', d: 2.2, kut: 0, dotyku: ['A', 'B'] }} />   — дві дотичні з точки P
//   <KoloElementy naKoli={{ A: 210, B: 100, C: 330 }} mnohokutnyk={['A', 'B', 'C']} kolirKola={3} />   — описане коло
//   <KoloElementy opysanyi={{ vershyny: ['C', 'B', 'A'], dotyku: ['M', 'L', 'K'], kuty: [270, 20, 140] }} kolirKola={3} />   — вписане
//   <KoloElementy priamaIKolo />   — три випадки: d < r, d = r, d > r
//   <KoloElementy dvaKola={{ R: 3, r: 2, d: 6, pidpys: 'd > R + r' }} ramka={false} />   — у <Ryad>
import { dvaKola, kolo, priamaIKolo, type KoloOpts } from '../trenazhery/kolo.ts';

interface Props extends KoloOpts {
  priamaIKolo?: boolean;
  dvaKola?: { R: number; r: number; d: number; pidpys?: string };
  ramka?: boolean;
  pidpys?: string;
}
const { pidpys, priamaIKolo: tryVypadky, dvaKola: dva, ramka = true, ...opts } = Astro.props;
const svg = tryVypadky ? priamaIKolo() : dva ? dvaKola(dva.R, dva.r, dva.d, dva.pidpys) : kolo(opts);
---

<figure class={ramka ? 'ill not-content' : 'not-content'}>
  <div class="ill-scroll" set:html={svg} />
  {pidpys && <p class="ill-caption" set:html={pidpys} />}
</figure>

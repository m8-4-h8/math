---
// «Драбина» степенів числа a: від a^verkh до a^nyz. Крок праворуч — показник на 1 менший, а значення ділимо на a.
// Так видно, чому a⁰ = 1 і a⁻ⁿ = 1/aⁿ. Додатні показники — одним кольором, нуль — іншим, від'ємні — третім.
//   <DrabynaStepeniv osnova={2} />
//   <DrabynaStepeniv osnova={10} verkh={3} nyz={-3} />
interface Props {
  osnova: number;
  verkh?: number;
  nyz?: number;
}
const { osnova: a, verkh = 3, nyz = -3 } = Astro.props;
if (!Number.isInteger(a) || a < 2) throw new Error('DrabynaStepeniv: основа — ціле число від 2');
if (verkh <= nyz) throw new Error('DrabynaStepeniv: verkh має бути більшим за nyz');

const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
const st = (k: number) => String(k).split('').map((c) => SUP[c]).join('');
// Чотирицифрові числа пишемо разом (1000), більші — з пробілом між класами (10 000), як на всьому сайті.
const ch = (v: number) => (String(v).length <= 4 ? String(v) : String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ' '));
const f = (v: number) => v.toFixed(1);

const pokaznyky: number[] = [];
for (let k = verkh; k >= nyz; k--) pokaznyky.push(k);
const KR = 74;
const W = pokaznyky.length * KR + 16;
const H = 156;
const x = (i: number) => 8 + KR * i + KR / 2;
const kolir = (k: number) => `var(--ill-${k > 0 ? 1 : k === 0 ? 3 : 4})`;

let tilo = '';
pokaznyky.forEach((k, i) => {
  const c = kolir(k);
  tilo += `<rect x="${f(x(i) - KR / 2 + 4)}" y="6" width="${KR - 8}" height="96" rx="10" fill="${c}" fill-opacity="0.12" stroke="${c}" stroke-width="1.5"/>`;
  tilo += `<text x="${f(x(i))}" y="32" text-anchor="middle" font-size="20" font-weight="700" fill="${c}">${a}${st(k)}</text>`;
  if (k >= 0) {
    tilo += `<text x="${f(x(i))}" y="76" text-anchor="middle" font-size="18" font-weight="700" fill="var(--ill-ink)">${ch(a ** k)}</text>`;
  } else {
    const znam = ch(a ** -k);
    const shyr = Math.max(16, znam.length * 10 + 6);
    tilo += `<text x="${f(x(i))}" y="64" text-anchor="middle" font-size="16" font-weight="700" fill="var(--ill-ink)">1</text>`;
    tilo += `<line x1="${f(x(i) - shyr / 2)}" y1="71" x2="${f(x(i) + shyr / 2)}" y2="71" stroke="var(--ill-ink)" stroke-width="1.8"/>`;
    tilo += `<text x="${f(x(i))}" y="90" text-anchor="middle" font-size="16" font-weight="700" fill="var(--ill-ink)">${znam}</text>`;
  }
  if (i < pokaznyky.length - 1) {
    const [x1, x2] = [x(i) + 14, x(i + 1) - 14];
    const m = (x1 + x2) / 2;
    tilo += `<path d="M ${f(x1)} 108 Q ${f(m)} 132 ${f(x2)} 108" fill="none" stroke="var(--ill-2)" stroke-width="2" stroke-linecap="round"/>`;
    tilo += `<path d="M ${f(x2 - 9)} 112 L ${f(x2)} 108 L ${f(x2 - 3)} 117" fill="none" stroke="var(--ill-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
    tilo += `<text x="${f(m)}" y="146" text-anchor="middle" font-size="14" font-weight="700" fill="var(--ill-2)">: ${a}</text>`;
  }
});
const znachennia = pokaznyky.map((k) => `${a}${st(k)} = ${k >= 0 ? ch(a ** k) : `1/${ch(a ** -k)}`}`).join(', ');
const opys = `Степені числа ${a}: ${znachennia}. Кожен крок праворуч — показник на 1 менший, а значення ділиться на ${a}.`;
---

<figure class="ill not-content">
  <div class="ill-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} role="img" aria-label={opys} set:html={tilo} />
  </div>
</figure>

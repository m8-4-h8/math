---
// Кнопка меню на телефоні: замість трьох рисочок — велика кнопка з написом «Теми»,
// щоб дитина одразу розуміла, де шукати інші теми.
import { Icon } from '@astrojs/starlight/components';
---

<button popovertarget="starlight__sidebar" class="knopka-menu sl-flex md:sl-hidden print:hidden">
  <Icon name="bars" class="open-menu" size="1.3rem" />
  <Icon name="close" class="close-menu" size="1.3rem" />
  <span class="pidpys-vidkryty">Теми</span>
  <span class="pidpys-zakryty">Закрити</span>
</button>

<style>
  button {
    position: fixed;
    top: calc((var(--sl-nav-height) - 2.75rem) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    align-items: center;
    gap: 0.4rem;
    height: 2.75rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: #fff;
    font: inherit;
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--sl-color-accent) 55%, #000);
    cursor: pointer;
  }
  button:has(~ :popover-open) {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    box-shadow: none;
  }
  button:has(~ :popover-open) :is(.open-menu, .pidpys-vidkryty),
  button:not(:has(~ :popover-open)) :is(.close-menu, .pidpys-zakryty) {
    display: none;
  }
</style>

<style is:global>
  body:has(#starlight__sidebar:popover-open) {
    overflow: hidden;
  }
  @media (min-width: 50rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: auto;
    }
  }
</style>

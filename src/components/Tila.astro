---
// Геометричні тіла: куб, прямокутний паралелепіпед, циліндр, конус, піраміда, куля.
// Невидимі ребра — пунктиром. Під кожним тілом — назва і скільки в нього граней, ребер, вершин.
// Приклад: <Tila /> (усі шість) або <Tila vydy={['kub', 'paralelepiped']} />
type Vyd = 'kub' | 'paralelepiped' | 'piramida' | 'tsylindr' | 'konus' | 'kulia';
interface Props {
  vydy?: Vyd[];
  rakhunok?: boolean; // показати грані, ребра, вершини (за замовчуванням так)
}
const { vydy = ['kub', 'paralelepiped', 'piramida', 'tsylindr', 'konus', 'kulia'], rakhunok = true } = Astro.props;

const TILA: Record<Vyd, { nazva: string; opys: string; d: string[]; dash: string[]; kolir: string; extra?: string }> = {
  kub: {
    nazva: 'Куб',
    opys: '6 граней-квадратів, 12 ребер, 8 вершин',
    d: ['M20 40 H90 V110 H20 Z', 'M20 40 L50 15 H120 L90 40', 'M120 15 V85 L90 110'],
    dash: ['M20 110 L50 85 H120', 'M50 85 V15'],
    kolir: 'var(--ill-1)',
  },
  paralelepiped: {
    nazva: 'Прямокутний паралелепіпед',
    opys: '6 граней-прямокутників, 12 ребер, 8 вершин',
    d: ['M10 55 H105 V110 H10 Z', 'M10 55 L35 30 H130 L105 55', 'M130 30 V85 L105 110'],
    dash: ['M10 110 L35 85 H130', 'M35 85 V30'],
    kolir: 'var(--ill-2)',
  },
  piramida: {
    nazva: 'Піраміда',
    opys: 'основа + бічні грані-трикутники; у чотирикутної — 5 граней, 8 ребер, 5 вершин',
    d: ['M15 100 L80 115 L120 92', 'M65 12 L15 100', 'M65 12 L80 115', 'M65 12 L120 92'],
    dash: ['M15 100 L55 78 L120 92', 'M65 12 L55 78'],
    kolir: 'var(--ill-3)',
  },
  tsylindr: {
    nazva: 'Циліндр',
    opys: 'дві основи-круги і бічна поверхня; ребер і вершин немає',
    d: ['M25 25 V100', 'M115 25 V100', 'M25 100 A45 12 0 0 0 115 100'],
    dash: ['M25 100 A45 12 0 0 1 115 100'],
    kolir: 'var(--ill-4)',
    extra: 'ellipse-top',
  },
  konus: {
    nazva: 'Конус',
    opys: 'основа-круг і вершина; ребер немає',
    d: ['M70 12 L25 100', 'M70 12 L115 100', 'M25 100 A45 12 0 0 0 115 100'],
    dash: ['M25 100 A45 12 0 0 1 115 100'],
    kolir: 'var(--ill-1)',
  },
  kulia: {
    nazva: 'Куля',
    opys: 'кругла з усіх боків, як м\'яч; ні граней, ні вершин',
    d: ['M70 62 m-48 0 a48 48 0 1 0 96 0 a48 48 0 1 0 -96 0', 'M22 62 A48 13 0 0 0 118 62'],
    dash: ['M22 62 A48 13 0 0 1 118 62'],
    kolir: 'var(--ill-2)',
  },
};
---

<figure class="ill not-content">
  <div class="tila">
    {
      vydy.map((v) => {
        const t = TILA[v];
        return (
          <div class="tilo">
            <svg viewBox="0 0 140 125" width="140" height="125" role="img" aria-label={t.nazva}>
              <g fill="none" stroke={t.kolir} stroke-width="2.5" stroke-linejoin="round">
                {v === 'kub' && <path d="M20 40 H90 V110 H20 Z" fill={t.kolir} fill-opacity="0.15" stroke="none" />}
                {v === 'paralelepiped' && <path d="M10 55 H105 V110 H10 Z" fill={t.kolir} fill-opacity="0.15" stroke="none" />}
                {v === 'kulia' && <circle cx="70" cy="62" r="48" fill={t.kolir} fill-opacity="0.12" stroke="none" />}
                {t.extra === 'ellipse-top' && <ellipse cx="70" cy="25" rx="45" ry="12" fill={t.kolir} fill-opacity="0.15" />}
                {t.d.map((d) => <path d={d} />)}
                {t.dash.map((d) => <path d={d} stroke-dasharray="5 5" opacity="0.7" />)}
              </g>
            </svg>
            <b>{t.nazva}</b>
            {rakhunok && <span class="muted opys">{t.opys}</span>}
          </div>
        );
      })
    }
  </div>
  <figcaption class="ill-caption">Пунктир — ребра, яких не видно за тілом</figcaption>
</figure>

<style>
  .tila {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
  }
  .tilo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }
  .opys {
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }
</style>

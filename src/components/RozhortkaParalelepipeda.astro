---
// Розгортка прямокутного паралелепіпеда a × b × c: шість прямокутників хрестом. Протилежні грані — одного кольору
// (їх по дві однакових). Під малюнком — площа поверхні S = 2(ab + bc + ac). Якщо a = b = c — розгортка куба.
//   <RozhortkaParalelepipeda a={4} b={2} c={3} />
interface Props {
  a: number; // довжина
  b: number; // ширина
  c: number; // висота
  odynytsi?: string;
}
const { a, b, c, odynytsi = 'см' } = Astro.props;

const kub = a === b && b === c;
const k = Math.min(28, 340 / (2 * b + a), 420 / (2 * b + 2 * c));
const m = 10;
const x0 = m + b * k;
const W = 2 * m + (2 * b + a) * k;
const H = 2 * m + (2 * b + 2 * c) * k + 18; // знизу — місце для підпису довжини
const fmt = (v: number) => String(v).replace('.', ',');
const okr = (v: number) => Math.round(v * 1000) / 1000;
type Hran = { x: number; y: number; w: number; h: number; kol: string; pidpys: string };
const yTop = m;
const yFront = yTop + b * k;
const yBottom = yFront + c * k;
const yBack = yBottom + b * k;
const hrani: Hran[] = [
  { x: x0, y: yTop, w: a * k, h: b * k, kol: 'c1', pidpys: 'верх' },
  { x: x0, y: yFront, w: a * k, h: c * k, kol: 'c3', pidpys: 'перед' },
  { x: x0 - b * k, y: yFront, w: b * k, h: c * k, kol: 'c4', pidpys: 'бік' },
  { x: x0 + a * k, y: yFront, w: b * k, h: c * k, kol: 'c4', pidpys: 'бік' },
  { x: x0, y: yBottom, w: a * k, h: b * k, kol: 'c1', pidpys: 'низ' },
  { x: x0, y: yBack, w: a * k, h: c * k, kol: 'c3', pidpys: 'зад' },
];
const [ab, bc, ac] = [okr(a * b), okr(b * c), okr(a * c)];
const S = okr(2 * (ab + bc + ac));
const opys = kub
  ? `Розгортка куба з ребром ${fmt(a)} ${odynytsi}: шість однакових квадратів, площа поверхні ${fmt(S)} ${odynytsi}²`
  : `Розгортка прямокутного паралелепіпеда ${fmt(a)} × ${fmt(b)} × ${fmt(c)} ${odynytsi}: площа поверхні ${fmt(S)} ${odynytsi}²`;
---

<figure class="ill not-content rozhortka-par">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={opys} style={`max-width:${W}px`}>
    {
      hrani.map((h) => (
        <g>
          <rect x={h.x} y={h.y} width={h.w} height={h.h} class={`hran ${h.kol}`} />
          <text x={h.x + h.w / 2} y={h.y + h.h / 2 + 4} text-anchor="middle" class="pidpys">
            {h.pidpys}
          </text>
        </g>
      ))
    }
    {/* Розміри — зовні, біля вільних країв: довжина під «задом», висота праворуч від «заду», ширина ліворуч від «верху». */}
    <text x={x0 + (a * k) / 2} y={yBack + c * k + 16} text-anchor="middle" class="rozmir">{fmt(a)}</text>
    <text x={x0 - 5} y={yTop + (b * k) / 2 + 5} text-anchor="end" class="rozmir">{fmt(b)}</text>
    <text x={x0 + a * k + 5} y={yBack + (c * k) / 2 + 5} class="rozmir">{fmt(c)}</text>
  </svg>
  <ol class="ill-steps">
    {
      kub ? (
        <>
          <li>
            Шість однакових квадратів по <b class="num">{fmt(a)} · {fmt(a)} = {fmt(ab)} {odynytsi}²</b>.
          </li>
          <li>
            Площа поверхні: <b class="num">6 · {fmt(ab)} = {fmt(S)} {odynytsi}²</b>.
          </li>
        </>
      ) : (
        <>
          <li>
            Верх і низ (<span class="c1">синій</span>): <b class="num">2 · {fmt(a)} · {fmt(b)} = {fmt(2 * ab)} {odynytsi}²</b>.
          </li>
          <li>
            Перед і зад (<span class="c3">зелений</span>): <b class="num">2 · {fmt(a)} · {fmt(c)} = {fmt(okr(2 * ac))} {odynytsi}²</b>.
          </li>
          <li>
            Два боки (<span class="c4">рожевий</span>): <b class="num">2 · {fmt(b)} · {fmt(c)} = {fmt(okr(2 * bc))} {odynytsi}²</b>.
          </li>
          <li>
            Площа поверхні: <b class="num">S = {fmt(okr(2 * ab))} + {fmt(okr(2 * ac))} + {fmt(okr(2 * bc))} = {fmt(S)} {odynytsi}²</b>.
          </li>
        </>
      )
    }
  </ol>
</figure>

<style>
  .rozhortka-par svg {
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .rozhortka-par .hran {
    stroke: var(--ill-ink);
    stroke-width: 1.5;
  }
  .rozhortka-par .hran.c1 {
    fill: color-mix(in srgb, var(--ill-1) 35%, transparent);
  }
  .rozhortka-par .hran.c3 {
    fill: color-mix(in srgb, var(--ill-3) 35%, transparent);
  }
  .rozhortka-par .hran.c4 {
    fill: color-mix(in srgb, var(--ill-4) 35%, transparent);
  }
  .rozhortka-par .pidpys {
    fill: var(--ill-ink);
    font-size: 11px;
  }
  .rozhortka-par .rozmir {
    fill: var(--ill-ink);
    font-weight: 700;
    font-size: 13px;
  }
  .rozhortka-par span.c1 {
    color: var(--ill-1);
    font-weight: 700;
  }
  .rozhortka-par span.c3 {
    color: var(--ill-3);
    font-weight: 700;
  }
  .rozhortka-par span.c4 {
    color: var(--ill-4);
    font-weight: 700;
  }
</style>

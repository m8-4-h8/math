---
// Тренажер: 10 завдань, які щоразу складаються заново з випадкових чисел, три рівні, серія правильних
// відповідей і від 1 до 3 зірок у кінці. Найкращий результат запам'ятовується в браузері.
// Завдання пише генератор теми — `src/trenazhery/<N>-klas/<тема>.ts` (див. `src/trenazhery/dopomoha.ts`).
//
//   <Trenazher />                        — тренажер теми, на сторінці якої він стоїть
//   <Trenazher tema="5-klas/vidsotky" /> — тренажер іншої теми
//   <Trenazher klas={5} />               — усі теми класу впереміш, дитина може обрати, які саме
//   <Trenazher temy={['5-klas/vidsotky', '6-klas/proportsii']} /> — обрані теми впереміш
//
// «Показати відповідь» відмикається лише після першої спроби (як у <Zavdannia>): спершу дитина пробує сама.
import { getCollection } from 'astro:content';
import type { Henerator } from '../trenazhery/dopomoha';

interface Props {
  tema?: string;
  temy?: string[];
  klas?: number;
  riven?: 1 | 2 | 3;
}
const { tema, temy, klas, riven = 1 } = Astro.props;

const heneratory = import.meta.glob<{ default: Henerator }>('../trenazhery/*-klas/*.ts', { eager: true });
const henerator = new Map(
  Object.entries(heneratory).map(([shliakh, modul]) => [shliakh.replace('../trenazhery/', '').replace(/\.ts$/, ''), modul.default]),
);
const baza = import.meta.env.BASE_URL.replace(/\/$/, '');
const storinky = await getCollection('docs');
const poriadok = (id: string) => storinky.find((s) => s.id === id)?.data.sidebar.order ?? Infinity;

let ids: string[];
if (klas !== undefined) {
  ids = [...henerator.keys()].filter((id) => id.startsWith(`${klas}-klas/`)).sort((a, b) => poriadok(a) - poriadok(b));
} else if (temy) {
  ids = temy;
} else {
  ids = [tema ?? Astro.url.pathname.slice(baza.length + 1).replace(/\/$/, '')];
}
if (!ids.length) throw new Error(`Trenazher: для ${klas} класу ще немає жодного генератора.`);

const spysok = ids.map((id) => {
  const h = henerator.get(id);
  const s = storinky.find((x) => x.id === id);
  if (!h) throw new Error(`Trenazher: немає генератора src/trenazhery/${id}.ts`);
  if (!s) throw new Error(`Trenazher: немає теми src/content/docs/${id}.mdx`);
  return { id, nazva: s.data.title, ikonka: s.data.ikonka || '📘', shliakh: `${baza}/${id}/`, rivni: h.rivni };
});
const kilka = spysok.length > 1;
const RIVNI = [
  { kod: 1, ikonka: '🐣', nazva: 'Легко' },
  { kod: 2, ikonka: '🦊', nazva: 'Середньо' },
  { kod: 3, ikonka: '🦁', nazva: 'Складно' },
];
---

<math-trenazher class="tren not-content" data-temy={JSON.stringify(spysok)} data-riven={riven} data-pagefind-ignore>
  <div class="tren-ekran tren-start">
    {
      kilka && (
        <div class="tren-temy-blok">
          {/* На телефоні список тем згорнутий за цією кнопкою, щоб «Рівень» і «Почати» були одразу видно. */}
          <button type="button" class="tren-temy-perem" aria-expanded="false">
            <span class="tren-temy-pidsumok" />
            <span class="tren-temy-strilka" aria-hidden="true">
              ▾
            </span>
          </button>
          <div class="tren-temy-vmist">
            <p class="tren-pidpys">Які теми тренуємо?</p>
            <div class="tren-vybir tren-temy" role="group" aria-label="Теми">
              {spysok.map((t) => (
                <button type="button" class="tren-tema" data-id={t.id} aria-pressed="true">
                  <span aria-hidden="true">{t.ikonka}</span> {t.nazva}
                </button>
              ))}
            </div>
            <p class="tren-vsi">
              <button type="button" class="tren-usi">Усі теми</button>
              <button type="button" class="tren-zhodnoi">Зняти всі</button>
            </p>
          </div>
        </div>
      )
    }
    <p class="tren-pidpys">Рівень</p>
    <div class="tren-vybir tren-rivni" role="group" aria-label="Рівень">
      {
        RIVNI.map(({ kod, ikonka, nazva }) => (
          <button type="button" class="tren-riven" data-kod={kod} aria-pressed={kod === riven ? 'true' : 'false'}>
            <span class="tren-riven-ikonka" aria-hidden="true">
              {ikonka}
            </span>{' '}
            {nazva}
          </button>
        ))
      }
    </div>
    {!kilka && <p class="tren-opys-rivnia" aria-live="polite">{spysok[0].rivni[riven - 1]}</p>}
    <button type="button" class="tren-hraty">▶ Почати</button>
    <p class="tren-rekord" hidden></p>
  </div>

  <div class="tren-ekran tren-hra" hidden>
    <div class="tren-verh">
      <ol class="tren-krapky" aria-label="Прогрес"></ol>
      <span class="tren-seriia" title="Правильних підряд"></span>
    </div>
    <div class="tren-malunok"></div>
    <p class="tren-pytannia"></p>
    <form class="tren-forma" autocomplete="off">
      <label class="tren-vyraz" for=""></label>
      <!-- Поле й OK — одна група: на вузькому екрані вона переходить на новий рядок цілком, а не «OK» окремо. -->
      <span class="tren-vvid">
        <span class="tren-shukane" aria-hidden="true" hidden></span>
        <input class="tren-pole" type="text" aria-label="Відповідь" />
        <span class="tren-odynytsi"></span>
        <button type="submit" class="tren-ok">OK</button>
      </span>
    </form>
    <div class="tren-varianty" role="group" aria-label="Варіанти відповіді" hidden></div>
    <p class="tren-vidhuk" aria-live="polite"></p>
    <div class="tren-rozviazok" hidden></div>
    <div class="tren-dii">
      <button type="button" class="tren-pokazaty" disabled>🔒 Відповідь — після твоєї спроби</button>
      <button type="button" class="tren-dali" hidden>Далі →</button>
    </div>
  </div>

  <div class="tren-ekran tren-kinets" hidden>
    <p class="tren-zirky" aria-hidden="true"></p>
    <p class="tren-rezultat"></p>
    <details class="tren-pomylky" hidden>
      <summary></summary>
      <ol></ol>
    </details>
    <button type="button" class="tren-znovu">🔄 Ще раз</button>
    <button type="button" class="tren-nalashtuvannia">⚙️ Змінити рівень</button>
  </div>
</math-trenazher>

<script>
  import { salut } from '../scripts/zirky';
  import { pravylno } from '../scripts/perevirka';
  import { shukane, stvorytyVypadok, type Henerator, type Riven, type TrenZavdannia } from '../trenazhery/dopomoha';

  const KILKIST = 10;
  // Кожен генератор — окремий маленький файл, який завантажується лише тоді, коли потрібен.
  const moduli = import.meta.glob<{ default: Henerator }>('../trenazhery/*-klas/*.ts');
  const zavantazhyty = (id: string) => moduli[`../trenazhery/${id}.ts`]().then((m) => m.default);

  // KaTeX потрібен лише для завдань з формулами ($...$), тож вантажимо його за потреби.
  type Katex = typeof import('katex').default;
  let katexObitsianka: Promise<Katex> | null = null;
  let katex: Katex | null = null;
  const pidhotuvatyKatex = () => (katexObitsianka ??= import('katex').then((m) => (katex = m.default)));

  // 30400 → «30 400», як у розв'язку (чотирицифрові не розбиваємо).
  const rozbyty = (v: string) => (/^-?\d{5,}$/.test(v) ? v.replace(/\B(?=(\d{3})+$)/g, '\u00a0') : v);
  // «64°» — градус пишемо впритул, решту одиниць — через пробіл: «12 см».
  const odynytsi = (o?: string) => (o ? (o.startsWith('°') ? '' : ' ') + ekran(o) : '');
  const ekran = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function html(tekst: string) {
    return tekst
      .split(/(\$[^$]+\$)/)
      .map((chastyna) =>
        chastyna.length > 2 && chastyna.startsWith('$') && chastyna.endsWith('$') && katex
          ? katex.renderToString(chastyna.slice(1, -1), { throwOnError: false })
          : ekran(chastyna),
      )
      .join('');
  }
  const tekstyZavdannia = (z: TrenZavdannia) =>
    [z.pytannia, z.vyraz, z.rozviazok, z.pidkazka, z.pokaz, ...(z.varianty || []).map(String)].filter(Boolean).join(' ');
  // «Відповідь: x = 7» — якщо шукали змінну (для віконця □ просто «Відповідь: 7»).
  const pidpysVidpovidi = (z: TrenZavdannia) => {
    const s = shukane(z);
    return s && !/□|square/.test(s) ? html(s) + ' = ' : '';
  };

  function chytaty(kluch: string) {
    try {
      return Number(localStorage.getItem(kluch)) || 0;
    } catch {
      return 0;
    }
  }
  function zapysaty(kluch: string, znachennia: number) {
    try {
      localStorage.setItem(kluch, String(znachennia));
    } catch {
      // Без сховища рекорд просто не збережеться.
    }
  }

  interface Tema {
    id: string;
    nazva: string;
    shliakh: string;
    rivni: [string, string, string];
  }
  interface Krok {
    tema: Tema;
    z: TrenZavdannia;
    vidpovidi: string[];
    sprob: number;
    sproba?: string; // остання відповідь дитини: з нею порівнюємо правильну
    pidsumok?: 'tak' | 'maizhe' | 'ne';
  }

  class MathTrenazher extends HTMLElement {
    connectedCallback() {
      const $ = <T extends HTMLElement>(s: string) => this.querySelector<T>(s)!;
      const ekrany = { start: $('.tren-start'), hra: $('.tren-hra'), kinets: $('.tren-kinets') };
      const pokazaty = (nazva: keyof typeof ekrany) =>
        Object.entries(ekrany).forEach(([k, el]) => (el.hidden = k !== nazva));
      const temy: Tema[] = JSON.parse(this.dataset.temy || '[]');
      const knopkyTem = [...this.querySelectorAll<HTMLButtonElement>('.tren-tema')];
      const rivni = [...this.querySelectorAll<HTMLButtonElement>('.tren-riven')];
      const opysRivnia = this.querySelector<HTMLElement>('.tren-opys-rivnia');
      const hraty = $<HTMLButtonElement>('.tren-hraty');
      const krapky = $('.tren-krapky');
      const malunokEl = $('.tren-malunok');
      const pytanniaEl = $('.tren-pytannia');
      const vyrazEl = $('.tren-vyraz');
      const forma = $<HTMLFormElement>('.tren-forma');
      const pole = $<HTMLInputElement>('.tren-pole');
      const odynytsiEl = $('.tren-odynytsi');
      const shukaneEl = $('.tren-shukane');
      const variantyEl = $('.tren-varianty');
      const vidhuk = $('.tren-vidhuk');
      const rozviazokEl = $('.tren-rozviazok');
      const pokazatyVidpovid = $<HTMLButtonElement>('.tren-pokazaty');
      const dali = $<HTMLButtonElement>('.tren-dali');
      const seriiaEl = $('.tren-seriia');
      const rekordEl = $('.tren-rekord');
      const blokTem = this.querySelector<HTMLElement>('.tren-temy-blok');
      const peremykachTem = this.querySelector<HTMLButtonElement>('.tren-temy-perem');
      const pidsumokTem = this.querySelector<HTMLElement>('.tren-temy-pidsumok');

      const id = 'tren-' + Math.random().toString(36).slice(2);
      pole.id = id;
      vyrazEl.setAttribute('for', id);
      if (blokTem && peremykachTem) {
        $('.tren-temy-vmist').id = id + '-temy';
        peremykachTem.setAttribute('aria-controls', id + '-temy');
        peremykachTem.addEventListener('click', () => {
          const vidkryty = peremykachTem.getAttribute('aria-expanded') !== 'true';
          peremykachTem.setAttribute('aria-expanded', String(vidkryty));
          blokTem.classList.toggle('vidkryto', vidkryty);
        });
      }

      // На телефоні тренажер вищий за екран, а знизу ще й клавіатура. Прокручуємо так, щоб було видно
      // частину від `vid` до `doEl`; якщо вся не влазить — головне видно `holovne`. Межі — те, що справді
      // видно: під шапкою сайту і над клавіатурою (visualViewport). Якщо все й так видно, нічого не рухаємо.
      const plavno = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      const dovesty = (vid: Element, doEl: Element, holovne: 'vid' | 'do') => {
        const vv = window.visualViewport;
        const shapka = document.querySelector('header.header')?.getBoundingClientRect().bottom ?? 0;
        const verh = Math.max(vv?.offsetTop ?? 0, shapka) + 8;
        const niz = (vv ? vv.offsetTop + vv.height : innerHeight) - 8;
        const v = vid.getBoundingClientRect().top;
        const d = doEl.getBoundingClientRect().bottom;
        let zsuv = 0;
        if (v < verh) zsuv = holovne === 'vid' ? v - verh : Math.max(v - verh, d - niz);
        else if (d > niz) zsuv = holovne === 'do' ? d - niz : Math.min(d - niz, v - verh);
        if (Math.abs(zsuv) > 4) window.scrollBy({ top: zsuv, behavior: plavno });
      };

      // Поле росте разом з відповіддю (довгий список дільників не ховається за краєм поля).
      const pidihnatyPole = () => pole.style.setProperty('--symvoliv', String(Math.max(pole.value.length, 1)));
      pole.addEventListener('input', () => {
        pole.classList.remove('nevirno');
        pidihnatyPole();
      });

      let kroky: Krok[] = [];
      let krok = 0;
      let seriia = 0;
      let zakinchene = false;

      const obrani = () =>
        knopkyTem.length ? temy.filter((t) => knopkyTem.find((b) => b.dataset.id === t.id)?.getAttribute('aria-pressed') === 'true') : temy;
      const riven = () => Number(rivni.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.kod || 1) as Riven;
      const kluchRekordu = () => `math-trenazher:${obrani().map((t) => t.id).join('+')}:${riven()}`;
      const onovyty = () => {
        const r = chytaty(kluchRekordu());
        rekordEl.hidden = !r;
        rekordEl.textContent = `🏆 Твій рекорд тут: ${r} з ${KILKIST}`;
        if (opysRivnia) opysRivnia.textContent = temy[0].rivni[riven() - 1];
        if (pidsumokTem) {
          const n = obrani().length;
          pidsumokTem.textContent =
            n === temy.length ? `📚 Теми: усі ${n}` : n ? `📚 Теми: ${n} з ${temy.length}` : '📚 Теми: жодної не обрано';
        }
        hraty.disabled = !obrani().length;
        hraty.textContent = obrani().length ? '▶ Почати' : 'Обери хоча б одну тему';
      };

      knopkyTem.forEach((b) =>
        b.addEventListener('click', () => {
          b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
          onovyty();
        }),
      );
      this.querySelector('.tren-usi')?.addEventListener('click', () => {
        knopkyTem.forEach((b) => b.setAttribute('aria-pressed', 'true'));
        onovyty();
      });
      this.querySelector('.tren-zhodnoi')?.addEventListener('click', () => {
        knopkyTem.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        onovyty();
      });
      rivni.forEach((b) =>
        b.addEventListener('click', () => {
          rivni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          onovyty();
        }),
      );

      const krapka = () => krapky.children[krok];
      const zakinchytyKrok = (pidsumok: 'tak' | 'maizhe' | 'ne') => {
        kroky[krok].pidsumok = pidsumok;
        krapka().classList.remove('zaraz');
        krapka().classList.add(pidsumok);
        zakinchene = true;
        // Не disabled, а readOnly: поле лишається у фокусі, і клавіатура телефона не ховається й не
        // вискакує знову між завданнями (від цього сторінка щоразу стрибала б).
        pole.readOnly = true;
        variantyEl.querySelectorAll('button').forEach((b) => (b.disabled = true));
        pokazatyVidpovid.hidden = true;
      };
      const vidkrytyRozviazok = (zVidpovid: boolean) => {
        const { z, vidpovidi } = kroky[krok];
        const chastyny = [];
        if (zVidpovid)
          chastyny.push(`<strong>Відповідь:</strong> ${pidpysVidpovidi(z)}${html(z.pokaz ?? rozbyty(vidpovidi[0]))}${odynytsi(z.odynytsi)}`);
        if (z.rozviazok) chastyny.push(html(z.rozviazok));
        rozviazokEl.innerHTML = chastyny.join('<br />');
        rozviazokEl.hidden = !chastyny.length;
        dali.hidden = false;
        dali.focus({ preventScroll: true });
        dovesty(vidhuk, dali, 'vid');
      };

      const nastupnyi = () => {
        if (krok >= KILKIST) return kinets();
        const { z, vidpovidi } = kroky[krok];
        zakinchene = false;
        malunokEl.innerHTML = z.malunok || '';
        malunokEl.hidden = !z.malunok;
        pytanniaEl.innerHTML = z.pytannia ? html(z.pytannia) : '';
        pytanniaEl.hidden = !z.pytannia;
        vyrazEl.innerHTML = z.vyraz ? html(z.vyraz) : '';
        vyrazEl.hidden = !z.vyraz;
        vidhuk.textContent = '';
        vidhuk.classList.remove('dobre', 'pohano', 'pidkazka');
        rozviazokEl.hidden = true;
        // Кнопка видна одразу, але відмикається лише після першої власної спроби.
        pokazatyVidpovid.hidden = false;
        pokazatyVidpovid.disabled = true;
        pokazatyVidpovid.textContent = '🔒 Відповідь — після твоєї спроби';
        dali.hidden = true;
        krapka().classList.add('zaraz');
        if (z.varianty) {
          forma.hidden = true;
          variantyEl.hidden = false;
          variantyEl.innerHTML = '';
          for (const v of z.varianty) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'tren-variant';
            b.innerHTML = html(String(v));
            b.addEventListener('click', () => vidpovisty(String(v), b));
            variantyEl.append(b);
          }
          // На телефоні: короткі варіанти («>», «Так», «12») — в один рядок, довші — по два в рядку,
          // зовсім довгі («за катетом і гострим кутом») — стовпчиком на всю ширину.
          const dovzhyna = Math.max(...z.varianty.map((v) => String(v).replace(/\\[a-z]+|[$\\{}]/gi, '').length));
          variantyEl.dataset.vyd = dovzhyna <= 4 ? 'riadok' : dovzhyna <= 10 ? 'dva' : 'stovpchyk';
          variantyEl.style.setProperty('--kilkist', String(Math.min(z.varianty.length, 4)));
          (variantyEl.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
          dovesty(this, variantyEl, 'do');
        } else {
          forma.hidden = false;
          variantyEl.hidden = true;
          pole.readOnly = false;
          pole.value = '';
          pole.classList.remove('virno', 'nevirno');
          pidihnatyPole();
          // Клавіатура на телефоні: цифри, цифри з комою або повна (для дробів, мінуса, слів).
          const persha = vidpovidi[0];
          const rezhym = /^\d+$/.test(persha) ? 'numeric' : /^\d+[.,]\d+$/.test(persha) ? 'decimal' : 'text';
          const inshaKlaviatura = pole.inputMode !== rezhym;
          pole.inputMode = rezhym;
          odynytsiEl.textContent = z.odynytsi || '';
          odynytsiEl.hidden = !z.odynytsi;
          // Рівняння «69 − 4 · x = 49»: поле окремим рядком «x = [ ]», а не одразу після «= 49»,
          // де його легко прийняти за місце для відповіді на приклад.
          const shuk = shukane(z);
          forma.classList.toggle('rivniannia', !!shuk);
          shukaneEl.innerHTML = shuk ? html(shuk) + ' =' : '';
          shukaneEl.hidden = !shuk;
          const nazva = shuk?.replace(/\$/g, '').replace(/□|\\square/, 'віконце');
          pole.setAttribute('aria-label', nazva ? `Відповідь: ${nazva} =` : 'Відповідь');
          dovesty(this, forma, 'do');
          // Інша клавіатура (цифри → повна) з'являється лише після нового фокуса. Якщо ж клавіатура та сама,
          // поле не відпускаємо — тоді вона не ховається між завданнями.
          if (inshaKlaviatura) pole.blur();
          pole.focus({ preventScroll: true });
        }
      };

      const vidpovisty = (vvid: string, knopka?: HTMLButtonElement) => {
        if (zakinchene) return;
        const k = kroky[krok];
        // Кнопка — це рівно один із варіантів, тож порівнюємо точно (у «поділити на 3» і «відняти 3»
        // однакові числа, і перевірка «досить тих самих чисел» їх би не розрізнила).
        const virno = knopka ? k.vidpovidi.includes(vvid) : pravylno(vvid, k.vidpovidi) || !!k.z.perevirka?.(vvid);
        if (virno) {
          (knopka ?? pole).classList.add('virno');
          const pershaSproba = k.sprob === 0;
          zakinchytyKrok(pershaSproba ? 'tak' : 'maizhe');
          if (pershaSproba) seriia++;
          seriiaEl.textContent = seriia >= 3 ? `🔥 ${seriia} підряд` : '';
          vidhuk.textContent = pershaSproba ? '✅ Так!' : '✅ Тепер правильно!';
          vidhuk.classList.add('dobre');
          if (pershaSproba) {
            setTimeout(() => {
              krok++;
              nastupnyi();
            }, 600);
          } else {
            vidkrytyRozviazok(false);
          }
          return;
        }
        k.sprob++;
        k.sproba = vvid.trim();
        seriia = 0;
        seriiaEl.textContent = '';
        if (knopka) {
          knopka.classList.add('nevirno');
          knopka.disabled = true;
        } else {
          // Червона рамка й «трусь» — помилку видно просто на полі, навіть коли решту закрила клавіатура.
          pole.classList.remove('nevirno');
          void pole.offsetWidth;
          pole.classList.add('nevirno');
          pole.select();
        }
        const zPidkazkoiu = k.sprob >= 2 && !!k.z.pidkazka;
        if (zPidkazkoiu) vidhuk.innerHTML = '💡 <strong>Підказка:</strong> ' + html(k.z.pidkazka!);
        else vidhuk.textContent = 'Ой, ні. Подумай ще раз!';
        vidhuk.classList.add('pohano');
        vidhuk.classList.toggle('pidkazka', zPidkazkoiu);
        // Відповідь можна підглянути лише після власної спроби.
        pokazatyVidpovid.disabled = false;
        pokazatyVidpovid.textContent = 'Показати відповідь';
        // Серед двох варіантів після помилки лишився один — показуємо розв'язок одразу.
        if (knopka && variantyEl.querySelectorAll('button:not(:disabled)').length <= 1) pokazatyVidpovid.click();
        else dovesty(knopka ? variantyEl : forma, pokazatyVidpovid, 'vid');
      };

      forma.addEventListener('submit', (e) => {
        e.preventDefault();
        const vvid = pole.value.trim();
        if (vvid) vidpovisty(vvid);
      });
      pokazatyVidpovid.addEventListener('click', () => {
        if (zakinchene || !kroky[krok].sprob) return;
        zakinchytyKrok('ne');
        vidhuk.textContent = `Порівняй зі своєю відповіддю «${kroky[krok].sproba}» і розбери розв'язок — наступне вийде! 🙂`;
        vidhuk.classList.remove('pohano', 'pidkazka');
        vidkrytyRozviazok(true);
      });
      dali.addEventListener('click', () => {
        krok++;
        nastupnyi();
      });

      const pochaty = async () => {
        const vybrani = obrani();
        if (!vybrani.length) return;
        hraty.disabled = true;
        const r = stvorytyVypadok();
        const rv = riven();
        const heneratory = new Map(await Promise.all(vybrani.map(async (t) => [t.id, await zavantazhyty(t.id)] as const)));
        // Теми по черзі (кожна приблизно порівну), потім перемішуємо — так завдання йдуть упереміш.
        const cherha: Tema[] = [];
        while (cherha.length < KILKIST) cherha.push(...r.peremishaty(vybrani));
        const bachyly = new Set<string>();
        kroky = r.peremishaty(cherha.slice(0, KILKIST)).map((tema) => {
          let z: TrenZavdannia | undefined;
          for (let sproba = 0; sproba < 30; sproba++) {
            try {
              z = heneratory.get(tema.id)!.zavdannia(r, rv);
            } catch (pomylka) {
              console.error(`Тренажер ${tema.id}:`, pomylka);
              continue;
            }
            const kluch = `${z.pytannia}|${z.vyraz}|${z.malunok ?? ''}`;
            if (!bachyly.has(kluch)) {
              bachyly.add(kluch);
              break;
            }
          }
          const vidpovidi = (Array.isArray(z!.vidpovid) ? z!.vidpovid : [z!.vidpovid]).map(String);
          return { tema, z: z!, vidpovidi, sprob: 0 };
        });
        if (kroky.some((k) => tekstyZavdannia(k.z).includes('$') || k.vidpovidi[0].includes('$'))) await pidhotuvatyKatex();
        krok = seriia = 0;
        krapky.innerHTML = '<li></li>'.repeat(KILKIST);
        seriiaEl.textContent = '';
        hraty.disabled = false;
        pokazaty('hra');
        nastupnyi();
      };

      const kinets = () => {
        const virno = kroky.filter((k) => k.pidsumok === 'tak').length;
        const zirok = virno === KILKIST ? 3 : virno >= 7 ? 2 : virno >= 4 ? 1 : 0;
        $('.tren-zirky').textContent = '⭐'.repeat(zirok) + '☆'.repeat(3 - zirok);
        const stary = chytaty(kluchRekordu());
        const tekst =
          virno === KILKIST
            ? 'Усі завдання правильно з першої спроби! Ти чемпіон! 🏆'
            : virno >= 7
              ? 'Дуже добре! Ще трішки — і буде ідеально.'
              : virno >= 4
                ? 'Непогано! Зіграй ще раз, і вийде краще.'
                : 'Не здавайся! Розбери помилки або спробуй рівень легше 💪';
        $('.tren-rezultat').textContent =
          `Правильно з першої спроби: ${virno} з ${KILKIST}. ${tekst}` + (virno > stary && stary ? ' Новий рекорд!' : '');
        if (virno > stary) zapysaty(kluchRekordu(), virno);

        // Розбір: завдання, де була помилка, з правильною відповіддю і розв'язком.
        const pomylky = kroky.filter((k) => k.pidsumok !== 'tak');
        const rozbir = $<HTMLDetailsElement>('.tren-pomylky');
        rozbir.hidden = !pomylky.length;
        rozbir.open = pomylky.length > 0 && pomylky.length <= 3;
        rozbir.querySelector('summary')!.textContent = `Розбери помилки (${pomylky.length})`;
        rozbir.querySelector('ol')!.innerHTML = pomylky
          .map(({ tema, z, vidpovidi }) => {
            const umova = (z.malunok || '') + [z.pytannia, z.vyraz].filter(Boolean).map((t) => html(t!)).join(' ');
            const vidpovid = pidpysVidpovidi(z) + html(z.pokaz ?? rozbyty(vidpovidi[0])) + odynytsi(z.odynytsi);
            const posylannia = temy.length > 1 ? ` <a href="${tema.shliakh}">Повторити тему «${ekran(tema.nazva)}» →</a>` : '';
            return `<li><div>${umova}</div><div><strong>Відповідь:</strong> ${vidpovid}</div>${
              z.rozviazok ? `<div class="tren-poyasnennia">${html(z.rozviazok)}</div>` : ''
            }${posylannia}</li>`;
          })
          .join('');
        pokazaty('kinets');
        dovesty(this, $('.tren-znovu'), 'vid');
        if (zirok === 3) salut($('.tren-zirky'));
      };

      hraty.addEventListener('click', pochaty);
      $('.tren-znovu').addEventListener('click', pochaty);
      $('.tren-nalashtuvannia').addEventListener('click', () => {
        onovyty();
        pokazaty('start');
        dovesty(this, hraty, 'vid');
      });
      onovyty();
    }
  }
  if (!customElements.get('math-trenazher')) customElements.define('math-trenazher', MathTrenazher);
</script>


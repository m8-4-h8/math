---
// Рух як лінія: дорогу малюємо відрізком, кожна година — однаковий шматочок довжиною `v`.
// Одне з трьох (відстань, швидкість або час) позначаємо «?» і знаходимо під малюнком.
interface Props {
  v: number; // швидкість: скільки проходимо за одиницю часу
  t: number; // час: скільки шматочків (ціле число, щоб їх можна було намалювати)
  shukaty?: 's' | 'v' | 't'; // що невідоме
  odynytsia?: string; // одиниця відстані
  chas?: string; // одиниця часу
}
const { v, t, shukaty = 's', odynytsia = 'км', chas = 'год' } = Astro.props;

const s = v * t;
const fmt = (x: number) => (Number.isInteger(x) ? String(x) : x.toFixed(2).replace(/\.?0+$/, '').replace('.', ','));

const seg = Math.max(44, Math.min(90, 440 / t));
const x0 = 30;
const x1 = x0 + seg * t;
const W = x1 + 40;
const yLine = 50;
const yBrace = 82;
const H = 124;
// Фігурна дужка під відрізком від a до b.
const duzhka = (a: number, b: number, y: number) => {
  const m = (a + b) / 2;
  return `M ${a} ${y} Q ${a} ${y + 8} ${a + 8} ${y + 8} H ${m - 8} Q ${m} ${y + 8} ${m} ${y + 16} Q ${m} ${y + 8} ${m + 8} ${y + 8} H ${b - 8} Q ${b} ${y + 8} ${b} ${y}`;
};
const pidpysS = shukaty === 's' ? `? ${odynytsia}` : `${fmt(s)} ${odynytsia}`;
const pidpysV = shukaty === 'v' ? '?' : `${fmt(v)} ${odynytsia}`;
---

<figure class="ill not-content">
  <div class="ill-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`Відрізок: ${t} шматочків по ${fmt(v)} ${odynytsia}`}>
      <line x1={x0} y1={yLine} x2={x1 + 22} y2={yLine} stroke="var(--ill-line)" stroke-width="2" />
      <path d={`M ${x1 + 14} ${yLine - 6} L ${x1 + 22} ${yLine} L ${x1 + 14} ${yLine + 6}`} fill="none" stroke="var(--ill-line)" stroke-width="2" />
      {
        Array.from({ length: t }, (_, i) => (
          <g>
            <line
              x1={x0 + i * seg + 3}
              y1={yLine}
              x2={x0 + (i + 1) * seg - 3}
              y2={yLine}
              stroke={`var(--ill-${(i % 2) + 1})`}
              stroke-width="6"
              stroke-linecap="round"
            />
            <text x={x0 + i * seg + seg / 2} y={yLine - 14} text-anchor="middle" font-size="12" fill={`var(--ill-${(i % 2) + 1})`}>
              {pidpysV}
            </text>
            <line x1={x0 + (i + 1) * seg} y1={yLine - 7} x2={x0 + (i + 1) * seg} y2={yLine + 7} stroke="var(--ill-ink)" stroke-width="1.5" />
            {shukaty !== 't' && (
              <text x={x0 + (i + 1) * seg} y={yLine + 22} text-anchor="middle" font-size="11" fill="var(--ill-muted)">
                {i + 1} {chas}
              </text>
            )}
          </g>
        ))
      }
      <circle cx={x0} cy={yLine} r="6" fill="var(--ill-ink)" />
      <text x={x0} y={yLine + 22} text-anchor="middle" font-size="11" fill="var(--ill-muted)">старт</text>
      <path d={duzhka(x0, x1, yBrace)} fill="none" stroke="var(--ill-line)" stroke-width="1.5" />
      <text x={(x0 + x1) / 2} y={yBrace + 34} text-anchor="middle" font-size="14" font-weight="700" fill="var(--ill-ink)">
        {pidpysS}
      </text>
    </svg>
  </div>
  <ol class="ill-steps">
    {
      shukaty === 's' && (
        <li>
          {t} шматочків по {fmt(v)} {odynytsia}: <b class="num">{fmt(v)} · {t} = {fmt(s)} ({odynytsia})</b>{' '}
          <span class="muted">— відстань = швидкість · час</span>
        </li>
      )
    }
    {
      shukaty === 'v' && (
        <li>
          {fmt(s)} {odynytsia} ділимо на {t} однакових шматочків: <b class="num">{fmt(s)} : {t} = {fmt(v)} ({odynytsia}/{chas})</b>{' '}
          <span class="muted">— швидкість = відстань : час</span>
        </li>
      )
    }
    {
      shukaty === 't' && (
        <li>
          Скільки шматочків по {fmt(v)} {odynytsia} вміщується в {fmt(s)} {odynytsia}?{' '}
          <b class="num">{fmt(s)} : {fmt(v)} = {t} ({chas})</b> <span class="muted">— час = відстань : швидкість</span>
        </li>
      )
    }
  </ol>
</figure>

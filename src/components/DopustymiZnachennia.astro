---
// Раціональний дріб як «машинка»: підставляємо x і рахуємо чисельник, знаменник і значення дробу. Там, де знаменник
// дорівнює 0, значення немає — це недопустиме значення змінної (клітинка червона).
// Многочлени — коефіцієнти від молодшого степеня: [-3, 1] — це x − 3, [-4, 0, 1] — x² − 4.
//   <DopustymiZnachennia chys={[6]} znam={[-3, 1]} x={[1, 2, 3, 4, 5]} />   — 6 / (x − 3)
import { tekst, znachennia } from '../trenazhery/alhebra.ts';

interface Props {
  chys: number[];
  znam: number[];
  x: number[];
  zminna?: string;
}
const { chys, znam, x, zminna = 'x' } = Astro.props;
const nsd = (a: number, b: number): number => (b === 0 ? Math.abs(a) : nsd(b, a % b));
const ch = (v: number) => (v < 0 ? `−${-v}` : `${v}`);
const stovpchyky = x.map((v) => {
  const n = znachennia(chys, v);
  const d = znachennia(znam, v);
  if (d === 0) return { x: v, n, d, drib: null };
  const g = nsd(n, d) || 1;
  const [p, q] = [(n / g) * Math.sign(d), Math.abs(d / g)];
  return { x: v, n, d, drib: { p, q } };
});
const nuli = stovpchyky.filter((s) => s.d === 0).map((s) => s.x);
const zapysChys = tekst(chys, zminna);
const zapysZnam = tekst(znam, zminna);
const opys = `Дріб ${zapysChys} поділити на ${zapysZnam}: таблиця значень при ${zminna} = ${x.map(ch).join(', ')}; ${
  nuli.length ? `при ${zminna} = ${nuli.map(ch).join(' і ')} знаменник дорівнює нулю, дріб не має змісту` : 'знаменник ніде не дорівнює нулю'
}`;
---

<figure class="ill not-content" aria-label={opys}>
  <p class="dz-formula">
    <span class="frac"><span>{zapysChys}</span><span>{zapysZnam}</span></span>
  </p>
  <div class="ill-scroll">
    <table class="dz-tablytsia">
      <tr>
        <th>{zminna}</th>
        {stovpchyky.map((s) => <td class:list={{ nul: s.d === 0 }}>{ch(s.x)}</td>)}
      </tr>
      <tr>
        <th class="c1">чисельник</th>
        {stovpchyky.map((s) => <td class:list={['c1', { nul: s.d === 0 }]}>{ch(s.n)}</td>)}
      </tr>
      <tr>
        <th class="c2">знаменник</th>
        {stovpchyky.map((s) => <td class:list={['c2', { nul: s.d === 0 }]}>{ch(s.d)}</td>)}
      </tr>
      <tr>
        <th class="c3">дріб</th>
        {
          stovpchyky.map((s) =>
            s.drib ? (
              <td class="c3">
                {s.drib.q === 1 ? ch(s.drib.p) : <span class="frac"><span>{ch(s.drib.p)}</span><span>{s.drib.q}</span></span>}
              </td>
            ) : (
              <td class="nul c4">немає</td>
            ),
          )
        }
      </tr>
    </table>
  </div>
  <ol class="ill-steps">
    <li>Підставляємо {zminna} у чисельник і знаменник, потім ділимо.</li>
    {
      nuli.length ? (
        <li>
          При <b class="c4">{zminna} = {nuli.map(ch).join(' і ')}</b> знаменник дорівнює <b>0</b>, а ділити на нуль не можна: дріб не має
          змісту. Це <b class="c4">недопустиме</b> значення змінної.
        </li>
      ) : (
        <li>Знаменник ніде не дорівнює нулю — дріб має зміст при всіх {zminna} з таблиці.</li>
      )
    }
  </ol>
</figure>

<style>
  .dz-formula {
    text-align: center;
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }
  .dz-tablytsia {
    margin: 0 auto;
    border-collapse: collapse;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .dz-tablytsia th,
  .dz-tablytsia td {
    border: 1px solid var(--ill-line);
    padding: 0.25rem 0.55rem;
    text-align: center;
    min-width: 2.2rem;
  }
  .dz-tablytsia th {
    font-weight: 600;
    text-align: left;
  }
  .dz-tablytsia tr:first-child th {
    font-style: italic;
    text-align: center;
  }
  .dz-tablytsia td.nul {
    background: color-mix(in srgb, var(--ill-4) 20%, transparent);
  }
  .dz-tablytsia .frac {
    font-size: 0.85em;
  }
</style>

---
// Множення і ділення круглих чисел «укрупненням розрядних одиниць»: кругле число замінюємо десятками
// (смужки) або сотнями (квадрати), рахуємо за таблицею множення, результат знову записуємо в одиницях.
//   <Ukrupnennia a={20} b={4} dia="·" />    — 4 групи по 2 десятки: 2 д. · 4 = 8 д. = 80
//   <Ukrupnennia a={80} b={4} dia=":" />    — 8 десятків порівну на 4 частини: по 2 д. = 20
//   <Ukrupnennia a={80} b={20} dia=":" />   — скільки разів по 2 д. вміщується у 8 д.: 4 (число без найменування)
//   <Ukrupnennia a={800} b={4} dia=":" />   — те саме сотнями
interface Props {
  a: number; // кругле число (ділене або перший множник)
  b: number; // одноцифровий множник / дільник або кругле число-дільник
  dia: '·' | ':';
}
const { a, b, dia } = Astro.props;

const sotniMozhna = (x: number) => x % 100 === 0;
let u: number; // розрядна одиниця: 10 або 100
let hrup: number; // скільки груп малюємо
let po: number; // скільки одиниць у групі
const naKruhle = dia === ':' && b >= 10;
if (dia === '·') {
  u = sotniMozhna(a) ? 100 : 10;
  hrup = b;
  po = a / u;
} else if (!naKruhle) {
  u = sotniMozhna(a) && (a / 100) % b === 0 ? 100 : 10;
  hrup = b;
  po = a / u / b;
} else {
  u = sotniMozhna(a) && sotniMozhna(b) ? 100 : 10;
  po = b / u;
  hrup = a / u / po;
}
if (a % 10 !== 0 || !Number.isInteger(po) || !Number.isInteger(hrup) || po < 1 || po > 10 || hrup < 1 || hrup > 12) {
  throw new Error(`Ukrupnennia: ${a} ${dia} ${b} — не підходить`);
}
const n = dia === '·' ? po * b : a / u; // усього розрядних одиниць
const sotni = u === 100;
const skor = sotni ? 'с.' : 'д.';

const forma = (k: number, [odna, dvi, bahato]: [string, string, string]) => {
  const k10 = k % 10;
  const k100 = k % 100;
  if (k10 === 1 && k100 !== 11) return odna;
  if (k10 >= 2 && k10 <= 4 && (k100 < 12 || k100 > 14)) return dvi;
  return bahato;
};
const slovo = (k: number) => `${k} ${forma(k, sotni ? ['сотня', 'сотні', 'сотень'] : ['десяток', 'десятки', 'десятків'])}`;

// Розміри: десяток — смужка з 10 клітинок, сотня — квадрат 10×10.
const k = sotni ? 4 : 5;
const shOdn = sotni ? 10 * k : k + 2;
const vOdn = 10 * k;
const krokOdn = shOdn + (sotni ? 5 : 4);
const pad = 7;
const boxW = po * krokOdn - (krokOdn - shOdn) + 2 * pad;
const boxH = vOdn + 2 * pad;
const G = 12;
const pidpysH = 18;
const maxW = 340;
const m = 6;
const kol = Math.max(1, Math.min(hrup, Math.floor((maxW - 2 * m + G) / (boxW + G))));
const riadiv = Math.ceil(hrup / kol);
const W = kol * (boxW + G) - G + 2 * m;
const H = riadiv * (boxH + pidpysH + 8) + m;
const kolir = sotni ? 'var(--ill-1)' : 'var(--ill-2)';

const hrupy = Array.from({ length: hrup }, (_, i) => ({
  x: m + (i % kol) * (boxW + G),
  y: m + Math.floor(i / kol) * (boxH + pidpysH + 8),
  pidpys: naKruhle ? String(i + 1) : `${po} ${skor}`,
}));

const aria =
  dia === '·'
    ? `${b} ${forma(b, ['група', 'групи', 'груп'])} по ${slovo(po)}`
    : naKruhle
      ? `${slovo(n)}, розкладені групами по ${po}`
      : `${slovo(n)}, поділені порівну на ${b} ${forma(b, ['частину', 'частини', 'частин'])}`;

const kroky =
  dia === '·'
    ? [`${a} = ${slovo(po)}.`, `${po} ${skor} · ${b} = ${n} ${skor}`, `${n} ${skor} = ${a * b}`]
    : naKruhle
      ? [`${a} = ${slovo(n)}, ${b} = ${slovo(po)}.`, `${n} ${skor} : ${po} ${skor} = ${hrup} — стільки разів по ${po} ${skor} вміщується в ${n} ${skor}`, `${a} : ${b} = ${hrup} — частка без найменування`]
      : [`${a} = ${slovo(n)}.`, `${n} ${skor} : ${b} = ${po} ${skor}`, `${po} ${skor} = ${a / b}`];
---

<figure class="ill not-content">
  <div class="ill-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={aria}>
      {
        hrupy.map((g) => (
          <g>
            <rect x={g.x} y={g.y} width={boxW} height={boxH} rx="9" fill="none" stroke="var(--ill-muted)" stroke-width="1.4" />
            {Array.from({ length: po }, (_, j) => {
              const x = g.x + pad + j * krokOdn;
              const y = g.y + pad;
              return (
                <g>
                  <rect x={x} y={y} width={shOdn} height={vOdn} fill={kolir} fill-opacity={sotni ? 0.22 : 0.3} stroke={kolir} stroke-width="1.3" />
                  {Array.from({ length: 9 }, (_, t) => (
                    <line x1={x} y1={y + (t + 1) * k} x2={x + shOdn} y2={y + (t + 1) * k} stroke={kolir} stroke-width="0.6" opacity="0.65" />
                  ))}
                  {sotni &&
                    Array.from({ length: 9 }, (_, t) => (
                      <line x1={x + (t + 1) * k} y1={y} x2={x + (t + 1) * k} y2={y + vOdn} stroke={kolir} stroke-width="0.6" opacity="0.65" />
                    ))}
                </g>
              );
            })}
            <text x={g.x + boxW / 2} y={g.y + boxH + 15} text-anchor="middle" font-size="13" font-weight="700" fill="var(--ill-ink)">{g.pidpys}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <ol class="ill-steps">
    {kroky.map((t) => <li><b class="num">{t}</b></li>)}
  </ol>
</figure>

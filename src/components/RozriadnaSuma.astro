---
// Усне додавання і віднімання по розрядах: кожне число розкладаємо на сотні, десятки й одиниці,
// дію виконуємо в кожному розряді окремо, потім складаємо результати.
// Якщо в розряді вийшло 10 і більше — це вже наступний розряд (підказка під таблицею).
//   <RozriadnaSuma a={346} b={252} />
//   <RozriadnaSuma a={34} b={25} />   — двоцифрові: рядка сотень немає
//   <RozriadnaSuma a={785} b={432} dia="−" />
//   <RozriadnaSuma a={65} b={26} dia="−" />   — одиниць не вистачає: зменшуване стає сумою зручних
//                                               доданків (65 = 50 + 15), підпис пояснює розмін
interface Props {
  a: number;
  b: number;
  dia?: '+' | '−';
}
const { a, b, dia = '+' } = Astro.props;
const plus = dia === '+';
const rozklad = (n: number) => [Math.floor(n / 100) * 100, (Math.floor(n / 10) % 10) * 10, n % 10];
const ra = rozklad(a);
const rb = rozklad(b);
// Віднімання, коли в розряді «не вистачає»: розмінюємо одиницю старшого розряду, і зменшуване
// стає сумою зручних доданків: 65 = 50 + 15, 302 = 200 + 90 + 12.
let rozmin = false;
if (!plus) {
  for (let i = 2; i > 0; i--) {
    if (ra[i] < rb[i]) {
      const odynytsia = i === 2 ? 10 : 100;
      ra[i] += odynytsia;
      ra[i - 1] -= odynytsia;
      rozmin = true;
    }
  }
}
const rez = ra.map((x, i) => (plus ? x + rb[i] : x - rb[i]));
if (rez.some((x) => x < 0)) throw new Error(`RozriadnaSuma: ${a} − ${b} — від'ємник більший за зменшуване`);
const vidpovid = plus ? a + b : a - b;
const NAZVY = ['сотні', 'десятки', 'одиниці'];
// Рядок сотень — лише для трицифрових чисел; рядок одиниць ховаємо, якщо обидва числа круглі (350 + 480).
const pokazaty = (i: number) => (i === 0 ? ra[0] > 0 || rb[0] > 0 : i === 1 || ra[2] > 0 || rb[2] > 0);
const KOLORY = ['var(--ill-1)', 'var(--ill-2)', 'var(--ill-3)'];
const perekhid = plus && rez.some((x, i) => i > 0 && x >= [1000, 100, 10][i]);
const dodanky = rez.filter((x) => x > 0);
---

<figure class="ill not-content rs">
  <table aria-label={`${a} ${dia} ${b} = ${vidpovid}`}>
    <tbody>
      {
        NAZVY.map((nazva, i) => pokazaty(i) && (
          <tr>
            <th style={`color:${KOLORY[i]}`}>{nazva}</th>
            <td>{ra[i]}</td>
            <td class="z">{dia}</td>
            <td>{rb[i]}</td>
            <td class="z">=</td>
            <td style={`color:${KOLORY[i]}`}>
              <b>{rez[i]}</b>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="ill-caption">
    <b class="num">
      {a} {dia} {b} = {dodanky.join(' + ')}{dodanky.length > 1 && <> = {vidpovid}</>}
    </b>
    {perekhid && (
      <>
        <br />у розряді вийшло 10 або більше — частина переходить у старший розряд
      </>
    )}
    {rozmin && (
      <>
        <br />
        {a} = {ra.filter((x) => x > 0).join(' + ')} — зменшуване записали сумою зручних доданків
      </>
    )}
  </p>
</figure>

<style>
  .rs table {
    margin: 0.4rem auto 0;
    border-collapse: collapse;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }
  .rs th {
    text-align: left;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem 0.3rem 0;
  }
  .rs td {
    text-align: right;
    padding: 0.3rem 0.35rem;
    border-top: 1px dashed var(--ill-line);
  }
  .rs tr:first-child td {
    border-top: none;
  }
  .rs td.z {
    color: var(--ill-muted);
  }
</style>
